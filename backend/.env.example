# Read by the backend when run outside Docker (uvicorn, pytest, alembic), from backend/.
# Copy to backend/.env. The password must match POSTGRES_PASSWORD in the root .env.
# In Docker, Compose overrides DATABASE_URL, TEST_DATABASE_URL and PUBLIC_BASE_URL.
DATABASE_URL=postgresql+asyncpg://snippet:change-me@localhost:5432/snippet
TEST_DATABASE_URL=postgresql+asyncpg://snippet:change-me@localhost:5432/snippet_test

# Vite dev server address, so share links work during local development.
PUBLIC_BASE_URL=http://localhost:5173

# Max paste size in UTF-8 bytes (1 MB).
MAX_PASTE_BYTES=1048576
