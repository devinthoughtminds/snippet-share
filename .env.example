# Read by Docker Compose (docker-compose.yml). Copy to .env and change the password.
POSTGRES_USER=snippet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=snippet

# Address users open in the browser; share links are built from it.
PUBLIC_BASE_URL=http://localhost:3000

# MCP server (port 8001). Password typed on its login page, and the key that signs its JWTs:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_PASSWORD=change-me
MCP_JWT_SECRET=change-me-to-32-or-more-random-characters
# Port on your machine for the MCP server; change it if 8001 is taken (then update MCP_URL in test-agent/snippet_agent/.env).
MCP_HOST_PORT=8001
# Port on your machine for the secret-scanner MCP server (stateless, no login).
MCP_SCANNER_HOST_PORT=8003

# ---- Optional: self-hosted Langfuse (docker compose --profile langfuse up -d), UI at http://localhost:3100.
# Generate each secret below with:  openssl rand -hex 32   (or python -c "import secrets; print(secrets.token_hex(32))")
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me
LANGFUSE_ENCRYPTION_KEY=change-me-to-64-hex-characters
LANGFUSE_POSTGRES_PASSWORD=change-me
LANGFUSE_CLICKHOUSE_PASSWORD=change-me
LANGFUSE_REDIS_AUTH=change-me
LANGFUSE_MINIO_PASSWORD=change-me
# Created on first start (no sign-up). No quotes around these values.
# The two MCP servers send traces with the two keys below, so tracing stays off while they're empty.
# To turn it on, fill both (for example pk-lf-<openssl rand -hex 16> and sk-lf-<openssl rand -hex 16>),
# then put the same keys in test-agent/snippet_agent/.env.
LANGFUSE_INIT_ORG_ID=snippet-share
LANGFUSE_INIT_PROJECT_ID=snippet-share
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=dev@example.com
LANGFUSE_INIT_USER_PASSWORD=change-me
