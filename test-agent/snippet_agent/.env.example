# Copy to .env in this folder. adk web loads it.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
AGENT_MODEL=gemini-2.5-flash
MCP_URL=http://localhost:8001/mcp
SCANNER_URL=http://localhost:8003/mcp
# Optional tracing to the local Langfuse (docker compose --profile langfuse up -d). Same keys as LANGFUSE_INIT_PROJECT_* in the root .env.
# Leave LANGFUSE_PUBLIC_KEY empty to keep tracing off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3100
