# Read by Vite at dev and build time. Copy to frontend/.env.
# VITE_* values are baked into the JS bundle and visible to everyone: never put secrets here.

# Max paste size in UTF-8 bytes. Must match MAX_PASTE_BYTES in backend/.env.
VITE_MAX_PASTE_BYTES=1048576

# Where the Vite dev server proxies /api (not used in the Docker build).
API_PROXY_TARGET=http://localhost:8000
